# Server Port & Environment
PORT=4000

# SQLite for local dev, or PostgreSQL for cloud production (e.g. Supabase, Neon, Railway)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication (Replace with a strong random 32+ character secret)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Allowed Client Origin (Your Vercel deployment URL or localhost)
CLIENT_ORIGIN="http://localhost:5173"

# File Storage for Chat Uploads
UPLOAD_DIR="./uploads"

# Optional LiveKit Credentials (if using managed LiveKit Cloud SFU)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
